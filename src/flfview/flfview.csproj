<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>flfview</AssemblyName>
    <RootNamespace>flfview</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Bundled corpus, copied beside the executable on build and publish (fonts/<tier>/). -->
  <ItemGroup>
    <Content Include="..\..\Corpus\OutputFLF\*.flf" LinkBase="fonts\verified" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Corpus\FontBookFLF\*.flf" LinkBase="fonts\clean" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
